# Server-local overrides for representationFilenameIdno plugin.
# Copy to plugin.local.conf on the server and edit values there.
# Keep plugin.conf under version control with enable = 0.

enable = 1
strip_extension = 1
preserve_existing_idno_on_insert = 1
sync_on_media_replace = 1
preserve_manual_idno_on_update = 1
set_preferred_label_from_filename_when_blank = 1
update_blank_preferred_label_on_media_replace = 1
replace_whitespace_with = _
lowercase = 0
ensure_unique = 1
suffix_separator = -

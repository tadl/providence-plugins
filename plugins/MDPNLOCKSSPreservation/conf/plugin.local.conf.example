# Copy to plugin.local.conf. Replace the synthetic institution and local paths.
# Set enable = 1 after reviewing the settings; the actual local file is ignored.
enable = 0
# Existing canonical directory, owned by the web/queue service account, mode 0700.
# Keep this outside the document root; include it in private backups.
state_directory = /srv/preservation-state
python_binary = /usr/bin/python3
organization_code = EXAMPLE
source_organization = Example Archive
# Optional defaults; blank values require staff to enter contacts on the form.
contact_name =
contact_email =
# Agree a maximum tar size with your receiver; this is a 50 GB starting value.
part_size_bytes = 50000000000
# generic requires an agreed BagIt staging workflow; it does not configure LOCKSS.
# For MDPN, select mdpn and use your approved name in the canonical MDPN settings.
# https://raw.githubusercontent.com/MiDPN/MDPN-Config/refs/heads/main/MDPN-DART-Settings.json
# organization_code remains YOUR institution's code in either mode (2-12 A-Z/0-9).
bagit_profile = generic
transport = local
destination_id = local-testing
# After a local pilot, configure a stable new destination and verified host key.
# transport = sftp
# destination_id = example-lockss
# sftp_host = ingest.example.org
# sftp_port = 22
# sftp_directory = /incoming
# OpenSSH SHA256: fingerprint, without trailing = padding; not a public-key line.
# sftp_host_key_sha256 = SHA256:REPLACE_WITH_INDEPENDENTLY_VERIFIED_FINGERPRINT
# credentials_file = /etc/providence/preservation-credentials.json
